# Copy to .env and fill in. Never commit .env (it is gitignored).
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (production/local runtime; test settings use SQLite — see config/settings/test.py)
DATABASE_NAME=azm_crm
DATABASE_USER=azm_crm
DATABASE_PASSWORD=changeme
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis (Celery broker, rate limiting, Channels later)
REDIS_URL=redis://localhost:6379/0

# Outbound/inbound email (ADR-006 / contracts/email.md)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=support@example.com
SUPPORT_EMAIL_DOMAIN=example.com

# Live chat (ADR-007). Redis above is now REQUIRED, not optional: without it there is no chat.
CHAT_DEFAULT_AGENT_CAPACITY=3
CHAT_PRESENCE_TTL_SECONDS=45
CHAT_HEARTBEAT_SECONDS=20
CHAT_RECONNECT_GRACE_SECONDS=60
CHAT_IDLE_WARNING_SECONDS=480
CHAT_IDLE_TIMEOUT_SECONDS=600
